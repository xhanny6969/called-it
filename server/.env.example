# Copy to server/.env and fill in. Never commit the real file.

# From @BotFather. Add the bot as an admin to your call channel, or to a group
# with privacy mode off (/setprivacy -> Disable), then send /start to it.
TELEGRAM_BOT_TOKEN=

# Binance demo trading (optional). Log in at demo.binance.com, profile > API
# Management > Create API (system generated). Orders only ever go to
# demo-fapi.binance.com. Without a key, a tap opens a paper trade instead.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional
PORT=8787
HOST=127.0.0.1          # 0.0.0.0 to reach it from a phone on the same Wi-Fi
TICK_MS=3000
