# Copy to server/.env and fill in. Never commit the real file.

# From @BotFather. Add the bot as an admin to your call channel, or to a group
# with privacy mode off (/setprivacy -> Disable), then send /start to it.
TELEGRAM_BOT_TOKEN=

# Optional
PORT=8787
HOST=127.0.0.1          # 0.0.0.0 to reach it from a phone on the same Wi-Fi
HL_NETWORK=mainnet      # prices and candles only; CalledIt never trades
TICK_MS=3000
